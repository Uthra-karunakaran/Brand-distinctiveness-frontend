# Where the Locify scoring API is listening. Read by src/api.js at build time.
#
# The default in the code is already http://127.0.0.1:8001, which is where
# `uvicorn api:app --reload --port 8001` serves — so for local dev you do not
# need a .env at all. Copy this file to .env only if the API moved.
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_, and only reads .env at
# server start: restart `npm run dev` after changing this.
VITE_API_BASE=http://127.0.0.1:8000

# Where the image classifier's /search endpoint is listening. The dev server
# proxies /classifier-api -> this target (see vite.config.js), so you only
# need VITE_CLASSIFIER_API_BASE itself for a build served without that proxy.
VITE_CLASSIFIER_API_TARGET=http://127.0.0.1:8002

# Sent as X-Client-Key on every API request. This is NOT a secret -- it ships
# in the built JS bundle and anyone can read it out of devtools -- it just
# filters out bots/scanners that hit the API URL directly without ever
# loading this page. Must match CLIENT_KEY on both backend deployments.
# Leave blank for local dev (both backends skip the check when unset).
VITE_CLIENT_KEY=
