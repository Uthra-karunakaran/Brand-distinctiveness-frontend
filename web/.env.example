# Where the Locify scoring API is listening. Read by src/api.js at build time.
#
# The default in the code is already http://127.0.0.1:8001, which is where
# `uvicorn api:app --reload --port 8001` serves — so for local dev you do not
# need a .env at all. Copy this file to .env only if the API moved.
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_, and only reads .env at
# server start: restart `npm run dev` after changing this.
VITE_API_BASE=http://127.0.0.1:8001
